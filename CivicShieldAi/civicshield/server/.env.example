# Server
PORT=5000
CLIENT_URL=http://localhost:5173

# Auth
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Demo mode (documented demo password used by seed.ts, never a production secret)
DEMO_PASSWORD=change-me-for-local-demo

# Persistence
# CivicShieldAI ships with a zero-setup embedded JSON file database (server/src/data/db.json)
# so the whole app can be demoed instantly without installing MongoDB.
# To use real MongoDB instead, set USE_MONGO=true and provide MONGO_URI, then implement
# the Mongoose models described in /docs/DATABASE.md (schemas already documented there).
USE_MONGO=false
MONGO_URI=mongodb://localhost:27017/civicshield
